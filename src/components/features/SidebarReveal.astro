---
// 侧边栏卡片滚动入场动画
// 卡片进入视口时滑入：奇数序号卡片从底部向上滑入，偶数序号从顶部向下滑入
// （方向类 sidebar-reveal-up/down 由 SideBar.astro 按卡片序号奇偶赋予）
// 仅桌面/平板端（>=768px）生效，移动端底部组件不受影响；尊重"减弱动态效果"偏好
---

<style is:global>
	@media (min-width: 768px) {
		.sidebar-reveal {
			opacity: 0;
			will-change: transform, opacity;
		}
		/* 从底部向上滑入 */
		.sidebar-reveal.sidebar-reveal-up {
			transform: translateY(2.5rem);
		}
		/* 从顶部向下滑入 */
		.sidebar-reveal.sidebar-reveal-down {
			transform: translateY(-2.5rem);
		}
		.sidebar-reveal.is-revealed {
			animation: sidebar-reveal-in 0.55s cubic-bezier(0.22, 0.61, 0.36, 1)
				forwards;
		}
	}

	@keyframes sidebar-reveal-in {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 用户偏好减弱动态效果时直接显示，不做位移动画 */
	@media (prefers-reduced-motion: reduce) {
		.sidebar-reveal {
			opacity: 1 !important;
			transform: none !important;
			animation: none !important;
		}
	}
</style>

<script>
	function initSidebarReveal(): void {
		// 用户偏好减弱动态效果时跳过，卡片由 CSS 兜底直接显示
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					observer.unobserve(el);
					el.classList.add("is-revealed");
				}
			},
			// 底部预留 6% 边距，卡片稍微露出视口即触发
			{ threshold: 0.08, rootMargin: "0px 0px -6% 0px" },
		);

		const observeAll = (): void => {
			document
				.querySelectorAll<HTMLElement>(".sidebar-reveal:not(.is-revealed)")
				.forEach((el) => observer.observe(el));
		};

		// 动画结束后固化为最终状态并移除动画类：避免重复触发，
		// 也避免残留的 opacity:0 初始样式影响后续显隐逻辑
		document.addEventListener("animationend", (event) => {
			const target = event.target as HTMLElement;
			if (!target.classList?.contains("is-revealed")) return;
			target.style.opacity = "1";
			target.style.transform = "none";
			target.classList.remove(
				"is-revealed",
				"sidebar-reveal",
				"sidebar-reveal-up",
				"sidebar-reveal-down",
			);
			observer.unobserve(target);
		});

		observeAll();
		// 静态侧边栏卡片首屏观察一次即可（Swup 不替换该区域）；
		// 动态侧边栏容器被 Swup 替换后重新观察新节点
		document.addEventListener("swup:content:replace", observeAll);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initSidebarReveal);
	} else {
		initSidebarReveal();
	}
</script>
