---
// 首页竖版卡片区：文章列表关闭后，把左侧栏配置的组件以竖版卡片形式
// 渲染在原文章列表所在的主内容区，入场动画上下方向交替滑入（由 SidebarReveal 驱动）
import Advertisement from "@/components/widget/Advertisement.astro";
import Announcement from "@/components/widget/Announcement.astro";
import Calendar from "@/components/widget/Calendar.astro";
import Categories from "@/components/widget/Categories.astro";
import Dynamic from "@/components/widget/Dynamic.astro";
import Music from "@/components/widget/Music.astro";
import Profile from "@/components/widget/Profile.astro";
import SidebarTOC from "@/components/widget/SidebarTOC.astro";
import SiteInfo from "@/components/widget/SiteInfo.astro";
import SiteStats from "@/components/widget/SiteStats.astro";
import Tags from "@/components/widget/Tags.astro";
import { sidebarLayoutConfig } from "@/config";

// 与 SideBar.astro 保持一致的组件映射表
const componentMap = {
	profile: Profile,
	announcement: Announcement,
	categories: Categories,
	tags: Tags,
	sidebarToc: SidebarTOC,
	advertisement: Advertisement,
	stats: SiteStats,
	calendar: Calendar,
	music: Music,
	siteInfo: SiteInfo,
	dynamic: Dynamic,
};

const cards = sidebarLayoutConfig.leftComponents.filter((comp) => comp.enable);
---

{
	cards.length > 0 && (
		<div class="home-cards-grid mb-4">
			{cards.map((comp, index) => {
				const Component = componentMap[comp.type];
				if (!Component) return null;
				// 竖版卡片依次入场：奇数序号卡片从底部向上滑入，偶数序号从顶部向下滑入
				const revealClass = `sidebar-reveal ${
					index % 2 === 0 ? "sidebar-reveal-up" : "sidebar-reveal-down"
				}`;
				return (
					<div class:list={["home-card", revealClass]}>
						<Component widgetConfig={comp} />
					</div>
				);
			})}
		</div>
	)
}

<style is:global>
	/* 竖版卡片网格：移动端单列，平板两列，桌面按卡片数量均分一行 */
	.home-cards-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	@media (min-width: 640px) {
		.home-cards-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1024px) {
		.home-cards-grid {
			grid-template-columns: repeat(
				auto-fit,
				minmax(11rem, 1fr)
			);
		}
	}

	/* 竖版卡片：固定 3:4 纵横比，内部 widget 卡片撑满整格，
	   内容超出时可滚动；widget 内的图片保持自身原有纵横比 */
	.home-card {
		aspect-ratio: 3 / 4;
		overflow-y: auto;
		border-radius: 0.75rem;
	}
	.home-card > * {
		height: 100%;
	}
</style>
