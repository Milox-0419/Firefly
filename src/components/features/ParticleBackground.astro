---
// 黑客风动态粒子背景（@tsparticles/astro 官方组件）
// 层级：壁纸(z-10) / 横幅文字(z-20) / 主内容(z-30) 之上，导航栏(z-50/80) 之下
// 粒子与连线不拦截任何点击（pointer-events: none）
import Particles from "@tsparticles/astro";
import type { ISourceOptions } from "@tsparticles/engine";

// 终端/矩阵绿 + 青色点缀，低透明度避免干扰正文阅读
const options: ISourceOptions = {
	fullScreen: { enable: false },
	fpsLimit: 60,
	detectRetina: true,
	interactivity: {
		detectsOn: "window",
		events: {
			onHover: { enable: true, mode: "grab" },
			onClick: { enable: true, mode: "repulse" },
		},
		modes: {
			// 鼠标悬停：附近粒子用连线向光标聚拢（黑客终端感）
			grab: {
				distance: 150,
				links: { opacity: 0.45 },
			},
			// 点击：粒子轻微散开
			repulse: {
				distance: 180,
				duration: 0.6,
			},
		},
	},
	particles: {
		number: {
			// 按面积限密度，控制总量，避免影响加载与滚动性能
			value: 50,
			density: { enable: true, width: 1200 },
		},
		color: { value: ["#00ff9c", "#22d3ee", "#9aff9c"] },
		shape: { type: "circle" },
		opacity: { value: { min: 0.15, max: 0.5 } },
		size: { value: { min: 1, max: 2.2 } },
		links: {
			enable: true,
			color: "#00ff9c",
			distance: 130,
			opacity: 0.15,
			width: 1,
		},
		move: {
			enable: true,
			speed: 0.5, // 缓慢飘浮
			direction: "none",
			random: true,
			straight: false,
			outModes: { default: "out" },
		},
	},
};
---

<div
	id="particle-background"
	class="fixed inset-0 pointer-events-none"
	style="z-index: 35;"
	aria-hidden="true"
>
	<Particles id="hacker-particles" options={options} />
</div>

<script>
	import { initParticlesEngine } from "@tsparticles/astro";
	import { loadSlim } from "@tsparticles/slim";

	// 在客户端初始化一次引擎（模块级单例，内部有幂等保护）
	// 必须在 <astro-particles> 元素升级前开始初始化
	void initParticlesEngine(async (engine) => {
		await loadSlim(engine);
	});
</script>

<style>
	/* 粒子画布铺满容器 */
	#particle-background :global(astro-particles),
	#particle-background :global(canvas) {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* 用户偏好减弱动态效果时隐藏粒子层 */
	@media (prefers-reduced-motion: reduce) {
		#particle-background {
			display: none;
		}
	}
</style>
